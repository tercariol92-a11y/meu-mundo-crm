rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is internal (admin, tecnico, etc)
    function isInternal() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) ||
        (request.auth.token.email != null && (
          request.auth.token.email.matches('.*@mundotechequipamentos\\.com\\.br$') ||
          request.auth.token.email.matches('.*@mundotechsolucoes\\.com\\.br$') ||
          request.auth.token.email.matches('(?i)tercariol92@gmail\\.com') ||
          request.auth.token.email.matches('(?i)jefferson@mundotechsolucoes\\.com\\.br') ||
          request.auth.token.email.matches('(?i)jeferson_tercariol2011@hotmail\\.com')
        ))
      );
    }

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        (
          get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('role', '') in ['admin', 'gerente', 'gerente_comercial'] ||
          get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('roles', []).hasAny(['admin', 'gerente', 'gerente_comercial'])
        );
    }

    function currentCompanyId() {
      return request.auth != null && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get(
            'companyId',
            get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get(
              'tenantId',
              get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('empresaId', 'default')
            )
          )
        : 'default';
    }
    
    // Helper function to get customer's linked client ID
    function getCustomerClienteId() {
      return get(/databases/$(database)/documents/customer_portal_users/$(request.auth.uid)).data.clienteId;
    }
    
    // Helper to check if user is an active customer portal user
    function isCustomer() {
      return request.auth != null && exists(/databases/$(database)/documents/customer_portal_users/$(request.auth.uid));
    }

    // Default wildcard fallback
    match /{collectionId}/{document=**} {
      allow read, write: if isInternal() &&
        collectionId != 'whatsapp_sessions' &&
        collectionId != 'agenda_comercial';
    }

    match /agenda_comercial/{appointmentId} {
      allow create: if isInternal() &&
        request.resource.data.companyId == currentCompanyId() &&
        (isAdmin() || request.resource.data.responsibleUserId == request.auth.uid);
      allow read: if isInternal() &&
        ((resource.data.companyId == currentCompanyId() &&
          (isAdmin() || resource.data.responsibleUserId == request.auth.uid)) ||
         (resource.data.companyId == null &&
          (isAdmin() || resource.data.responsavelId == request.auth.uid)));
      allow update: if isInternal() &&
        request.resource.data.companyId == currentCompanyId() &&
        ((resource.data.companyId == currentCompanyId() &&
          (isAdmin() || (resource.data.responsibleUserId == request.auth.uid && request.resource.data.responsibleUserId == request.auth.uid))) ||
         (resource.data.companyId == null &&
          (isAdmin() || (resource.data.responsavelId == request.auth.uid && request.resource.data.responsibleUserId == request.auth.uid))));
      allow delete: if isAdmin() && resource.data.companyId == currentCompanyId();
    }

    match /whatsapp_sessions/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    // Configuracoes rules
    match /configuracoes/{docId} {
      allow read: if request.auth != null;
      allow write: if isInternal();
    }

    // Customer Portal Users rules
    match /customer_portal_users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isInternal());
    }

    // Usuarios rules
    match /usuarios/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isInternal());
    }

    // Clientes rules
    match /clientes/{clienteId} {
      allow read: if isInternal() || (isCustomer() && getCustomerClienteId() == clienteId);
      allow write: if isInternal();

      match /contatos/{contatoId} {
        allow read: if isInternal() || (isCustomer() && getCustomerClienteId() == clienteId);
        allow write: if isInternal();
      }
    }

    // Unidades rules
    match /unidades/{unidadeId} {
      allow read: if isInternal() || (isCustomer() && getCustomerClienteId() == resource.data.clienteId);
      allow write: if isInternal();
    }

    // Equipamentos Cliente rules
    match /equipamentos_cliente/{eqId} {
      allow read: if isInternal() || (isCustomer() && getCustomerClienteId() == resource.data.clienteId);
      allow write: if isInternal();
    }

    // Chamados rules
    match /chamados/{chamadoId} {
      allow create: if isInternal() || (isCustomer() && getCustomerClienteId() == request.resource.data.clienteId);
      allow read, update: if isInternal() || (isCustomer() && getCustomerClienteId() == resource.data.clienteId);
      allow delete: if isInternal();
    }

    // Documentos rules
    match /documentos/{docId} {
      allow read: if isInternal() || (isCustomer() && getCustomerClienteId() == resource.data.clienteId);
      allow write: if isInternal();
    }

    // Contratos rules
    match /contratos/{contratoId} {
      allow read: if isInternal() || (isCustomer() && getCustomerClienteId() == resource.data.clienteId);
      allow write: if isInternal();
    }

    // Solicitacoes Equipamento rules
    match /solicitacoes_equipamento/{solId} {
      allow create: if isInternal() || (isCustomer() && getCustomerClienteId() == request.resource.data.clienteId);
      allow read, update, delete: if isInternal() || (isCustomer() && getCustomerClienteId() == resource.data.clienteId);
    }

    // Modelos Mapeamento rules
    match /modelos_mapeamento/{modelId} {
      allow create: if isInternal() || (isCustomer() && getCustomerClienteId() == request.resource.data.clienteId);
      allow read, update, delete: if isInternal() || (isCustomer() && getCustomerClienteId() == resource.data.clienteId);
    }

    // Equipamentos Importados rules
    match /equipamentos_importados/{impId} {
      allow create: if isInternal() || (isCustomer() && getCustomerClienteId() == request.resource.data.clienteId);
      allow read, update, delete: if isInternal() || (isCustomer() && getCustomerClienteId() == resource.data.clienteId);
    }

    // WhatsApp Config rules
    match /whatsapp_config/{docId} {
      allow read, write: if isInternal();
    }

    // WhatsApp Templates rules
    match /whatsapp_templates/{docId} {
      allow read, write: if isInternal();
    }

    // WhatsApp Logs rules
    match /whatsapp_logs/{docId} {
      allow read, write: if isInternal();
    }

    // Tarefas e Gestão de Tarefas rules
    match /tarefas/{docId} {
      allow read, write: if isInternal();
    }
    match /modelos_tarefas/{docId} {
      allow read, write: if isInternal();
    }
    match /historico_tarefas/{docId} {
      allow read, write: if isInternal();
    }
    match /pontuacao_tarefas/{docId} {
      allow read, write: if isInternal();
    }
    match /logs_tarefas/{docId} {
      allow read, write: if isInternal();
    }
  }
}
