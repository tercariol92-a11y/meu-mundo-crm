{
  "name": "mundo-tech-service",
  "private": true,
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:whatsapp": "esbuild server/railwayServer.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-whatsapp/railwayServer.mjs",
    "start:whatsapp": "node dist-whatsapp/railwayServer.mjs",
    "start": "node dist/server.cjs",
    "postinstall": "node -e \"const fs = require('fs'); const p = './node_modules/whatsapp-rust-bridge/package.json'; if (fs.existsSync(p)) { const j = JSON.parse(fs.readFileSync(p, 'utf8')); j.main = './dist/index.js'; if (j.exports && j.exports['.']) { j.exports['.'].require = './dist/index.js'; j.exports['.'].default = './dist/index.js'; } fs.writeFileSync(p, JSON.stringify(j, null, 2)); console.log('Patched whatsapp-rust-bridge exports successfully!'); }\" && node scripts/patch-baileys-profile-picture.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "mobile": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios"
  },
  "dependencies": {
    "@fastify/busboy": "^3.2.0",
    "@google/genai": "^1.29.0",
    "@react-native-async-storage/async-storage": "1.21.0",
    "@supabase/supabase-js": "^2.48.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/nodemailer": "^8.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "axios": "^1.14.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.1",
    "expo": "~50.0.0",
    "expo-constants": "~15.4.5",
    "expo-device": "~5.9.3",
    "expo-image-picker": "~14.7.1",
    "expo-linking": "~6.2.2",
    "expo-notifications": "~0.27.6",
    "expo-router": "~3.4.7",
    "expo-status-bar": "~1.11.1",
    "express": "^4.21.2",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.8.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.546.0",
    "lucide-react-native": "^0.344.0",
    "nodemailer": "^8.0.7",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-native": "0.73.4",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-paper": "^5.12.3",
    "react-native-reanimated": "~3.6.2",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0",
    "react-native-vector-icons": "^10.0.3",
    "sharp": "^0.34.5",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^6.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~18.2.45",
    "@types/react-signature-canvas": "^1.0.7",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vite": "^6.2.0"
  }
}
