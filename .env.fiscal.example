PORT=3002
NODE_ENV=production
FISCAL_ENVIRONMENT=producao_restrita
FISCAL_PRODUCTION_ENABLED=false
SEFIN_RESTRICTED_BASE_URL=https://sefin.producaorestrita.nfse.gov.br
SEFIN_PRODUCTION_BASE_URL=https://sefin.nfse.gov.br
# Deve apontar para um volume persistente e privado do serviço fiscal.
FISCAL_CERTIFICATE_STORAGE_PATH=/data/fiscal-private
# Base64 de exatamente 32 bytes. Deve existir somente no serviço fiscal.
FISCAL_CERTIFICATE_ENCRYPTION_KEY=
FISCAL_STORAGE_BUCKET=
FISCAL_SERVICE_INTERNAL_SECRET=
FISCAL_XSD_ACTIVE_VERSION=2026-07-27
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
